        "default": "mdi:restart"
      }
    },
    "select": {
      "camera_standby": {
        "default": "mdi:sleep"
      },
      "camera_fps_setting": {
        "default": "mdi:speedometer"
      },
      "camera_resolution": {
        "default": "mdi:aspect-ratio"
      }
    },
    "camera": {
      "camera_1": {
        "default": "mdi:camera"
      },
      "camera_2": {
        "default": "mdi:camera"
      },
      "camera_3": {
        "default": "mdi:camera"
